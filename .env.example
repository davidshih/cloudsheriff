# Copy to .env and fill in. .env is gitignored.

# AWS: admin profile for the dedicated sandbox account.
# Used for `tofu apply`, drift.sh, and for assuming CloudSheriffAuditRole.
AWS_PROFILE=cs-sandbox
AWS_REGION=us-east-1

# From `tofu output -raw audit_role_arn` and audit_external_id in terraform.tfvars
CS_AUDIT_ROLE_ARN=
CS_AUDIT_EXTERNAL_ID=

# https://app.daytona.io -> Keys
DAYTONA_API_KEY=

# https://app.arize.com -> Space settings
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=cloudsheriff

# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# CS_MODEL=claude-opus-5-5

# Local SurrealDB (`surreal start --user root --pass root surrealkv://data/cloudsheriff.db`)
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root

# Copy to .env and fill in. .env is gitignored.

# AWS: repo-local profile (see README "AWS access"). Keys live in .aws/credentials, never here.
#   .aws/credentials  [cs-mgmt]    management-account IAM user key
#   .aws/config       [profile cs-sandbox] role_arn = arn:aws:iam::<lab-account>:role/OrganizationAccountAccessRole, source_profile = cs-mgmt
AWS_CONFIG_FILE=/absolute/path/to/daytona-hackathon/.aws/config
AWS_SHARED_CREDENTIALS_FILE=/absolute/path/to/daytona-hackathon/.aws/credentials
AWS_PROFILE=cs-sandbox
AWS_REGION=us-east-1

# From `tofu output -raw audit_role_arn` and audit_external_id in terraform.tfvars
CS_AUDIT_ROLE_ARN=
CS_AUDIT_EXTERNAL_ID=

# https://app.daytona.io -> Keys
DAYTONA_API_KEY=

# https://app.arize.com -> Space settings
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=cloudsheriff

# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5; claude-sonnet-5 is cheaper for testing
# CS_MODEL=claude-sonnet-5

# Local SurrealDB (`surreal start --user root --pass root surrealkv://data/cloudsheriff.db`)
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
